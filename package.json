{
    "name": "ai-workbench",
    "displayName": "AI 工作台",
    "description": "跨项目管理 AI Agent 会话的工作台",
    "version": "0.1.0",
    "publisher": "lhg",
    "license": "MIT",
    "engines": {
        "vscode": "^1.95.0"
    },
    "categories": [
        "Other"
    ],
    "main": "./dist/extension.js",
    "activationEvents": [
        "onStartupFinished"
    ],
    "capabilities": {
        "untrustedWorkspaces": {
            "supported": true
        }
    },
    "contributes": {
        "viewsContainers": {
            "auxiliarybar": [
                {
                    "id": "aiWorkbench",
                    "title": "AI 工作台",
                    "icon": "media/icon.svg"
                }
            ]
        },
        "views": {
            "aiWorkbench": [
                {
                    "id": "aiWorkbench.assistant",
                    "name": "助手",
                    "type": "webview"
                }
            ]
        },
        "commands": [
            {
                "command": "aiWorkbench.createWorkspace",
                "title": "AI 工作台：创建多根工作区",
                "icon": "$(workspace-untrusted)"
            },
            {
                "command": "aiWorkbench.openAssistant",
                "title": "AI 工作台：打开助手",
                "icon": "$(sparkle)"
            },
            {
                "command": "aiWorkbench.explorerSessionList",
                "title": "AI 工作台：查看会话列表"
            }
        ],
        "menus": {
            "explorer/context": [
                {
                    "command": "aiWorkbench.explorerSessionList",
                    "when": "explorerResourceIsFolder",
                    "group": "aiWorkbench@1"
                }
            ]
        }
    },
    "scripts": {
        "vscode:prepublish": "npm run build",
        "build": "node esbuild.mjs --production",
        "watch": "node esbuild.mjs --watch",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest"
    },
    "devDependencies": {
        "@types/node": "^24.0.0",
        "@types/vscode": "^1.95.0",
        "esbuild": "^0.25.0",
        "typescript": "^5.7.0",
        "vitest": "^3.0.0"
    }
}